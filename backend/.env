# Environment Configuration for Multi-Agent AI Research Assistant

# Server Environment
ENV=development
PROJECT_NAME="Multi-Agent AI Research Assistant"
VERSION="1.0.0"

# OpenAI API Key
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"

# Web Search API Key (Tavily/Serper/Brave)
SEARCH_API_KEY="your-search-api-key-here"
SEARCH_PROVIDER="tavily"

DATABASE_URL="sqlite+aiosqlite:///./multi_agent_research.db"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres:your_password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Security
JWT_SECRET="super-secret-jwt-key-multi-agent-assistant-2026"
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
